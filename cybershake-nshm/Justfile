# Build the talk: figures -> PNGs -> Typst deck -> HTML and PowerPoint.
#
#   just            # everything, in order
#   just deck       # just the PDF (figures must already exist)
#   just watch      # live-rebuild the PDF while editing
#
# The Typst deck is the design source. The HTML deck is the one to present
# from, because it can play the Marlborough video; the PowerPoint is the
# fallback for a machine with no usable browser. Both render every Typst page,
# so neither can drift from the PDF.

png := "out/png"
repo := "/home/jake/src/monte_carlo_hazard_estimation_code"
eqvis := "/home/jake/src/eqvis_workflow"
rupgen := "/home/jake/src/rupture_generator"
ppi := "300"

default: figures deck html pptx

# Matplotlib figures (PEP-723 scripts, run with uv). The Marlborough figures
# read the run in /var/tmp/marlborough_1848 (rclone from
# dropbox:/QuakeCoRE/Jake/Marlborough/marlborough_1848).
figures:
    mkdir -p {{png}}
    uv run scripts/plot_key_idea.py --out {{png}}/key-idea.png --dpi {{ppi}}
    uv run scripts/plot_generator_preview.py --out {{png}}/generator-preview.png --dpi {{ppi}}
    uv run scripts/plot_world_map.py --out {{png}}/world-map.png --dpi {{ppi}}
    uv run scripts/plot_marlborough_topo.py --out-dir {{png}} --dpi {{ppi}}
    uv run --project {{eqvis}} python -I scripts/plot_marlborough_residual.py --out-dir {{png}} --dpi {{ppi}}
    # The rupture-generation slide runs the generator itself on a made-up system.
    uv run --project {{rupgen}} --with matplotlib python -I scripts/plot_rupture_steps.py --out-dir {{png}} --dpi {{ppi}}
    # Efficiency curves come from the analysis repo, so the deck cannot drift
    # from the numbers. Slide variant: no maps, poster type scaled for a slide.
    uv run {{repo}}/report/make_efficiency_figure.py {{repo}}/data/density.h5 \
        {{repo}}/pilot_runs_emod3d_with_event_attributes.csv {{repo}}/data/ruptures.parquet \
        {{repo}}/data/all_real_sites.parquet {{repo}}/data/coastline.wkb {{png}} \
        --width-cm 22 --curves-only --font-scale 0.5

# The Typst deck.
deck:
    typst compile main.typ

# One PNG per slide, for reviewing the deck without opening a PDF viewer.
slides: deck
    typst compile main.typ '{{png}}/slide-{p}.png' --format png --ppi 110

# The PowerPoint fallback: every page rendered from main.typ, speaker notes from
# the `// SAY:` blocks, and the Marlborough video embedded over its poster.
pptx: deck
    uv run make_pptx.py

# The HTML deck: every page as SVG, speaker view on `s`, the Marlborough video
# playing in place. Open out/html/index.html in a browser; the folder is
# self-contained, so it can be copied to a USB stick as is.
html: deck
    uv run ../tools/make_html.py --title "Cybershake NZ: towards simulations in the NSHM"

watch:
    typst watch main.typ

# Not `rm -rf out`: out/ also holds the video cut and its poster frame, which
# no recipe here regenerates.
clean:
    rm -rf out/pptx out/html main.pdf {{png}}/slide-*.png
